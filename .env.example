# Backend (copy to backend/.env)
PORT=5000
# Dedicated database for SoundBox; do not point this at a database you care about.
MONGODB_URI=mongodb://127.0.0.1:27017/soundbox_dev
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173
# Where uploaded audio/covers are stored (default: backend/uploads)
# UPLOAD_DIR=
