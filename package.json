{
  "name": "soundbox",
  "version": "2.0.0",
  "description": "SoundBox — your personal music universe",
  "private": true,
  "type": "module",
  "main": "backend/src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch backend/src/server.js",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "NODE_ENV=production node backend/src/server.js",
    "seed": "node backend/src/scripts/seed.js",
    "test": "vitest run --root backend",
    "test:web": "npm --prefix frontend run test",
    "test:e2e": "npm --prefix frontend run e2e",
    "install:all": "npm install && npm --prefix frontend install"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.9",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
